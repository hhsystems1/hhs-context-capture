{
  "name": "hhs-context-capture",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first, platform-agnostic preservation of exact accessible rendered AI conversations.",
  "workspaces": [
    "apps/*",
    "adapters/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -ws --if-present",
    "build:extension": "node scripts/build-extension.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "check": "npm run typecheck && npm test && npm run build && npm run lint",
    "collector": "tsx --env-file=.env.memory-v1.local apps/local-collector/src/server.ts",
    "mission-control": "tsx --env-file=.env.memory-v1.local apps/mission-control/src/server.ts",
    "mission-control:prove": "tsx --env-file=.env.memory-v1.local apps/mission-control/src/prove.ts",
    "inspection:generate": "tsx --env-file=.env.memory-v1.local apps/mission-control/src/archive-inspector-cli.ts generate",
    "inspection:verify": "tsx --env-file=.env.memory-v1.local apps/mission-control/src/archive-inspector-cli.ts verify",
    "hhs:status": "tsx --env-file=.env.memory-v1.local scripts/hhs.ts status",
    "hhs:security": "tsx --env-file=.env.memory-v1.local scripts/hhs-security-probe.ts",
    "hhs:up": "tsx --env-file=.env.memory-v1.local scripts/hhs.ts up",
    "hhs:down": "tsx --env-file=.env.memory-v1.local scripts/hhs.ts down",
    "operations:report": "tsx --env-file=.env.memory-v1.local apps/local-collector/src/operations-cli.ts report",
    "operations:reconcile": "tsx --env-file=.env.memory-v1.local apps/local-collector/src/operations-cli.ts reconcile",
    "operations:prove": "tsx --env-file=.env.memory-v1.local apps/local-collector/src/operations-cli.ts prove",
    "audit:inventory": "node scripts/audit-inventory.mjs",
    "plan:reconciliation": "tsx scripts/plan-capture-reconciliation.ts",
    "memory:start": "supabase start",
    "memory:stop": "supabase stop",
    "memory:reset": "supabase db reset",
    "memory:provision": "tsx scripts/provision-memory-v11-local.ts",
    "memory:ingest": "tsx --env-file=.env.memory-v1.local apps/memory-ingest/src/cli.ts ingest",
    "memory:report": "tsx --env-file=.env.memory-v1.local apps/memory-ingest/src/cli.ts report",
    "memory:prove": "tsx --env-file=.env.memory-v1.local apps/memory-ingest/src/cli.ts prove",
    "memory:prove:corrective": "tsx --env-file=.env.memory-v1.local apps/memory-ingest/src/cli.ts prove-corrective",
    "memory:review:list": "tsx --env-file=.env.memory-v1.local apps/memory-ingest/src/cli.ts review-list",
    "memory:review:show": "tsx --env-file=.env.memory-v1.local apps/memory-ingest/src/cli.ts review-show",
    "memory:review:approve": "tsx --env-file=.env.memory-v1.local apps/memory-ingest/src/cli.ts review-approve",
    "memory:review:reject": "tsx --env-file=.env.memory-v1.local apps/memory-ingest/src/cli.ts review-reject",
    "memory:query": "tsx --env-file=.env.memory-v1.local apps/memory-ingest/src/cli.ts query",
    "memory:prove:review": "tsx --env-file=.env.memory-v1.local apps/memory-ingest/src/prove-review.ts",
    "memory:query:service:provision": "tsx scripts/provision-memory-query-service-local.ts",
    "memory:query:service": "tsx --env-file=.env.memory-query-service.local apps/memory-ingest/src/query-service.ts",
    "reconstruction:priority:discover": "node scripts/run-next-priority-nemotron.mjs",
    "reconstruction:oversized:chunk": "node scripts/run-oversized-chunk-nemotron.mjs",
    "reconstruction:oversized:link": "node scripts/run-oversized-linker-nemotron.mjs",
    "reconstruction:oversized:run": "node --env-file=.env.memory-v1.local scripts/run-oversized-orchestrator.mjs",
    "memory:context:operations:service": "tsx apps/memory-ingest/src/context-operations-service.ts",
    "reconstruction:run": "node --env-file=.env.memory-v1.local scripts/run-reconstruction-batch.mjs",
    "reconstruction:audit": "tsx --env-file=.env.memory-v1.local scripts/reconstruction-quality-audit.ts",
    "memory:reconcile": "tsx --env-file=.env.memory-v1.local apps/memory-ingest/src/cli.ts reconcile",
    "memory:promote": "tsx --env-file=.env.memory-v1.local apps/memory-ingest/src/cli.ts promote",
    "memory:review:evidence": "tsx --env-file=.env.memory-v1.local apps/memory-ingest/src/cli.ts review-evidence"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.2",
    "@types/node": "^26.1.1",
    "@types/pg": "8.20.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "playwright": "^1.61.1",
    "supabase": "2.109.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "jsonrepair": "^3.15.0",
    "pg": "8.22.0"
  }
}
