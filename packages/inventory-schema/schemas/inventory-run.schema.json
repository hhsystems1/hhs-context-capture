{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helpinghands.systems/schemas/inventory-run/0.1.0",
  "title": "Platform-Agnostic Conversation Inventory Run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "inventory_id", "platform", "account", "started_at", "completed_at", "status", "boundary_verification", "observations", "evidence", "warnings", "snapshot_sha256"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "inventory_id": { "type": "string", "minLength": 1 },
    "platform": {
      "type": "object", "additionalProperties": false, "required": ["platform_id", "observed_host"],
      "properties": { "platform_id": { "type": "string", "minLength": 1 }, "observed_host": { "type": "string", "minLength": 1 } }
    },
    "account": {
      "type": "object", "additionalProperties": false, "required": ["opaque_account_reference"],
      "properties": { "opaque_account_reference": { "type": "string", "minLength": 8 } }
    },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["complete", "partial", "needs_review"] },
    "boundary_verification": {
      "type": "object", "additionalProperties": false,
      "required": ["earliest_reached", "latest_reached", "scroll_stabilized", "observation_count_stabilized", "initial_position_restored"],
      "properties": {
        "earliest_reached": { "type": "boolean" }, "latest_reached": { "type": "boolean" },
        "scroll_stabilized": { "type": "boolean" }, "observation_count_stabilized": { "type": "boolean" },
        "initial_position_restored": { "type": "boolean" }
      }
    },
    "observations": { "type": "array", "items": { "$ref": "#/$defs/observation" } },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "snapshot_sha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "kind", "media_type", "value", "sha256", "evidence_locator", "captured_at"],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["observation_log", "sanitized_dom", "screenshot"] },
        "media_type": { "type": "string", "minLength": 1 }, "value": { "type": "string" },
        "sha256": { "$ref": "#/$defs/hash" }, "evidence_locator": { "type": "string", "minLength": 1 },
        "captured_at": { "type": "string", "format": "date-time" }
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["observation_id", "conversation_id", "title", "sidebar_position", "observed_at", "observation_fingerprint", "visible_status_indicators", "evidence_ids", "review_status", "review_reasons", "platform_metadata"],
      "properties": {
        "observation_id": { "type": "string", "minLength": 1 }, "conversation_id": { "type": "string", "minLength": 1 },
        "platform_conversation_id": { "type": "string", "minLength": 1 }, "title": { "type": "string" }, "source_url": { "type": "string" },
        "sidebar_position": { "type": "integer", "minimum": 0 }, "observed_at": { "type": "string", "format": "date-time" },
        "observation_fingerprint": { "$ref": "#/$defs/hash" },
        "visible_status_indicators": { "type": "array", "items": { "type": "string" } },
        "evidence_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "review_status": { "enum": ["clear", "needs_review"] },
        "review_reasons": { "type": "array", "items": { "type": "string" } },
        "platform_metadata": { "type": "object" }
      }
    }
  }
}
