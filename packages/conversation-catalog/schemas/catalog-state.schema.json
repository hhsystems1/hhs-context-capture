{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helpinghands.systems/schemas/conversation-catalog/0.1.0",
  "title": "Persistent Local Conversation Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "applied_transactions", "inventories", "conversations"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "revision": { "type": "integer", "minimum": 0 },
    "applied_transactions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "inventories": { "type": "object", "additionalProperties": { "$ref": "#/$defs/inventory" } },
    "conversations": { "type": "object", "additionalProperties": { "$ref": "#/$defs/conversation" } }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "inventory": {
      "type": "object", "additionalProperties": false,
      "required": ["inventory_id", "platform_id", "opaque_account_reference", "status", "completed_at", "snapshot_sha256", "transaction_id"],
      "properties": {
        "inventory_id": { "type": "string", "minLength": 1 }, "platform_id": { "type": "string", "minLength": 1 },
        "opaque_account_reference": { "type": "string", "minLength": 8 }, "status": { "enum": ["complete", "partial", "needs_review"] },
        "completed_at": { "type": "string" }, "snapshot_sha256": { "$ref": "#/$defs/hash" }, "transaction_id": { "type": "string", "minLength": 1 }
      }
    },
    "classification": {
      "type": "object", "additionalProperties": false,
      "required": ["classification", "reason_codes", "inventory_id", "decided_at"],
      "properties": {
        "classification": { "enum": ["new", "possibly_changed", "unchanged", "missing", "needs_review"] },
        "reason_codes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "inventory_id": { "type": "string", "minLength": 1 }, "observation_id": { "type": "string", "minLength": 1 }, "decided_at": { "type": "string" }
      }
    },
    "capture": {
      "type": "object", "additionalProperties": false,
      "required": ["capture_id", "conversation_id", "archive_path", "manifest_sha256", "captured_at", "status", "message_count", "message_hashes"],
      "properties": {
        "capture_id": { "type": "string", "minLength": 1 }, "conversation_id": { "type": "string", "minLength": 1 },
        "archive_path": { "type": "string", "minLength": 1 }, "manifest_sha256": { "$ref": "#/$defs/hash" }, "captured_at": { "type": "string" },
        "status": { "enum": ["complete", "partial", "failed", "needs_review"] }, "message_count": { "type": "integer", "minimum": 0 },
        "message_hashes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/hash" } }
      }
    },
    "conversation": {
      "type": "object", "additionalProperties": false,
      "required": ["catalog_key", "platform_id", "opaque_account_reference", "conversation_id", "title", "first_observed_at", "last_observed_at", "last_observation_fingerprint", "last_inventory_id", "review_status", "classification", "capture_versions"],
      "properties": {
        "catalog_key": { "$ref": "#/$defs/hash" }, "platform_id": { "type": "string", "minLength": 1 },
        "opaque_account_reference": { "type": "string", "minLength": 8 }, "conversation_id": { "type": "string", "minLength": 1 },
        "platform_conversation_id": { "type": "string", "minLength": 1 }, "title": { "type": "string" }, "source_url": { "type": "string" },
        "first_observed_at": { "type": "string" }, "last_observed_at": { "type": "string" },
        "last_observation_fingerprint": { "$ref": "#/$defs/hash" }, "last_inventory_id": { "type": "string", "minLength": 1 },
        "review_status": { "enum": ["clear", "needs_review"] }, "classification": { "$ref": "#/$defs/classification" },
        "capture_versions": { "type": "array", "items": { "$ref": "#/$defs/capture" } }
      }
    }
  }
}
